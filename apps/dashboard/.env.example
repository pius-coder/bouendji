# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
# Doit pointer vers PORT de l'API (défaut 8080, voir apps/api/.env.example).
API_BASE_URL=http://localhost:8080
# Même valeur que DASHBOARD_ACCESS_KEY dans apps/api/.env.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_ACCESS_KEY=
