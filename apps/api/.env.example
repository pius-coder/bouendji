# ---------------------------------------------------------------------------
# API — copier en .env, remplir, ne jamais committer.
# Toute valeur absente ici est celle par defaut de src/config.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# PGlite (chemin local) ou Postgres (URL). En production : URL.
# DATABASE_URL=postgres://user:pass@host:5432/vpn
DATABASE_URL=./data/pg

# 32 octets en base64. Obligatoire en production, genere en dev sinon.
# openssl rand -base64 32
MASTER_KEY=

# Secret de signature des jetons. Obligatoire des qu'il y a plusieurs instances.
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=45

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Sondes internes --------------------------------------------------------
# Clé dédiée à /healthz et /readyz ; requise en production.
# openssl rand -hex 32
HEALTHCHECK_KEY=

# --- Paiement ---------------------------------------------------------------
# mock en developpement, fapshi en production.
PAYMENT_PROVIDER=mock
FAPSHI_BASE_URL=https://live.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Secret partagé du webhook, requis en production.
FAPSHI_WEBHOOK_SECRET=
FAPSHI_PAYOUT_USER=
FAPSHI_PAYOUT_KEY=
# Ne jamais faire confiance au corps du webhook : on re-lit le statut.
FAPSHI_VERIFY_WITH_API=true

# --- Email ------------------------------------------------------------------
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com

# --- Endpoints (ingestion) --------------------------------------------------
# 32 octets aleatoires, partages avec le conteneur d'endpoint.
# openssl rand -hex 32
ENDPOINT_INGEST_SECRET=
# false en production : un noeud doit etre approuve avant d'entrer dans le pool.
ENDPOINT_AUTO_APPROVE=true
ENDPOINT_MIN_TTL=3600
ENDPOINT_MAX_TTL=2592000
# 4 h 30, impose par la duree de vie du projet (D21).
ENDPOINT_DEFAULT_TTL=16200
# Retire du pool 15 min avant la mort du noeud.
ENDPOINT_DRAIN_LEAD=900
# Rotation du tunnel cote client : 55 min < plafond Cloud Run de 60 min (D25).
ENDPOINT_RECONNECT_AFTER=3300
ENDPOINT_HEARTBEAT=30

# --- Notifications Telegram -------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alerte quand le dernier noeud actif expire dans moins de N minutes.
DEPLOY_WARN_MINUTES=30

# --- Application Android / builds -------------------------------------------
MOCK_BUILDS=true
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WORKFLOW=android-brand.yml
GITHUB_REF=main
BUILDS_BASE_URL=

# --- Integrite --------------------------------------------------------------
ENFORCE_PLAY_INTEGRITY=false

# --- Seed (pnpm --filter @vpn/api seed) -------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_COMMUNITY_NAME=Bouendji
SEED_COMMUNITY_SLUG=bouendji
SEED_APP_NAME=Bouendji VPN
SEED_PACKAGE_NAME=cm.bouendji.vpn
# Prix provisoires, a valider avant toute vente.
SEED_PRICE_1M=5000
SEED_PRICE_3M=13500
SEED_PRICE_12M=48000

# --- Fichier de secours hors-ligne ------------------------------------------
# Cle privee Ed25519 PKCS#8 en base64 (tools/offline-keygen.mjs).
# Vide = fonction desactivee : la route repond 409 avec un message explicite,
# elle ne produit jamais un fichier non signe.
OFFLINE_BUNDLE_SIGNING_KEY=
# Validite du fichier. Court : un fichier qui traine ne doit pas rester utilisable.
OFFLINE_BUNDLE_TTL_MINUTES=60
