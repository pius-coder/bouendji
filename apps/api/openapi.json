{
  "openapi": "3.1.0",
  "info": {
    "title": "VPN Platform API",
    "description": "API de la plateforme VPN en marque blanche : appareils, comptes, commandes, paiements, abonnements, bundles chiffrés, ingestion d'endpoints, console d'administration.\n\nDeux preuves distinctes : la preuve d'appareil signée (`X-Device-*`) pour le mobile, et le jeton d'administration (`Authorization: Bearer`, audience `vpn-admin`) plus la clé d'accès (`X-Access-Key`) pour la console.",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "deviceProof": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Token",
        "description": "Jeton d'appareil. À accompagner de `X-Device-Timestamp`, `X-Device-Nonce` et `X-Device-Signature` (signature ECDSA sur METHOD\\nPATH\\nsha256(body)\\ntimestamp\\nnonce)."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Jeton de session (audience `vpn-mobile`) ou d'administration (`vpn-admin`)."
      },
      "accessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Key",
        "description": "Clé d'accès de la console (D54), exigée sur tout `/v1/admin/*`."
      },
      "ingest": {
        "type": "http",
        "scheme": "bearer",
        "description": "`ENDPOINT_INGEST_SECRET` pour `/v1/internal/*` (hors callback de build)."
      }
    },
    "schemas": {}
  },
