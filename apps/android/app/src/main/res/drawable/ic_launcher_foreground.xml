<?xml version="1.0" encoding="utf-8"?>
<!--
  Avant-plan de l'icône adaptative : un anneau, dessiné (aucune image produite).

  Les deux couleurs viennent de `brand.properties` (`launcherBackground`,
  `launcherMark`) via `resValue` dans build.gradle.kts : aucune marque figée.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anneau extérieur (rayon 26, dans la zone sûre de 72 dp). -->
    <path
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M54,28a26,26 0 1,0 0,52a26,26 0 1,0 0,-52z" />

    <!-- Évidement : même teinte que le fond, donc invisible sur l'icône. -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M54,39a15,15 0 1,0 0,30a15,15 0 1,0 0,-30z" />

    <!-- Point de session, en bas de l'anneau. -->
    <path
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M54,72a4,4 0 1,0 0,8a4,4 0 1,0 0,-8z" />
</vector>
